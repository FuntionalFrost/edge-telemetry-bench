{
	"name": "edge-telemetry-bench",
	"version": "0.1.0",
	"description": "Adversarial benchmarking suite and real-time telemetry interrogator for serverless JS isolates and edge runtimes",
	"license": "MIT",
	"homepage": "https://edge-telemetry-bench.vercel.app",
	"repository": {
		"type": "git",
		"url": "https://github.com/FuntionalFrost/edge-telemetry-bench.git"
	},
	"type": "module",
	"packageManager": "pnpm@11.24.0",
	"engines": {
		"node": ">=24"
	},
	"keywords": [
		"sveltekit",
		"svelte5",
		"vercel",
		"vercel-serverless",
		"isolate",
		"telemetry",
		"benchmark",
		"spectre",
		"webassembly",
		"tailwindcss",
		"lucide",
		"security"
	],
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@lucide/svelte": "^1.46.0",
		"@sveltejs/adapter-vercel": "^6.3.3",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.5.1",
		"eslint": "^10.10.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.70.0",
		"vite": "^8.3.0"
	},
	"dependencies": {
		"tailwind-variants": "^3.3.1",
		"yaxa-svelte": "^1.10.0",
		"zod": "^4.6.5"
	}
}
