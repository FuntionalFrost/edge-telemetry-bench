{
	"name": "edge-telemetry-bench",
	"version": "0.1.0",
	"description": "Adversarial benchmarking suite and real-time telemetry interrogator for serverless JS isolates and edge runtimes",
	"license": "MIT",
	"type": "module",
	"packageManager": "pnpm@11.24.0",
	"engines": {
		"node": ">=24"
	},
	"keywords": [
		"sveltekit",
		"svelte5",
		"cloudflare-workers",
		"vercel-edge",
		"isolate",
		"telemetry",
		"benchmark",
		"spectre",
		"webassembly",
		"carbon-design-system"
	],
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"build:cloudflare": "cross-env DEPLOY_TARGET=cloudflare vite build",
		"build:vercel": "cross-env DEPLOY_TARGET=vercel vite build",
		"build:vercel:node": "cross-env DEPLOY_TARGET=vercel VERCEL_RUNTIME=nodejs22.x vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@lucide/svelte": "^1.41.0",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/adapter-vercel": "^6.3.4",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.4.1",
		"cross-env": "^10.1.0",
		"eslint": "^10.9.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.69.0",
		"vite": "^8.2.2",
		"wrangler": "^4.129.0"
	},
	"dependencies": {
		"zod": "^4.5.4"
	}
}
